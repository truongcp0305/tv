package templates

type Star struct {
	Name  string
	Type  int
	Color string
}

type Palace struct {
	Name        string
	Stem        string
	Branch      string
	Stars       []Star
	LongLife    string
	MajorCycle  string
	MinorCycle  string
}

func starColorClass(color string) string {
	switch color {
	case "red", "hung":
		return "text-red-600"
	case "blue", "lam":
		return "text-blue-600"
	case "green", "xanh":
		return "text-green-600"
	default:
		return "text-slate-700"
	}
}

templ Palace(p Palace) {
	<div class="bg-white min-h-[120px] lg:min-h-[140px] xl:min-h-[160px] border border-slate-300 transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 hover:border-indigo-400 flex flex-col">
		<!-- Header -->
		<div class="px-1.5 py-1 lg:px-2 lg:py-1 border-b border-slate-200 flex items-center justify-between shrink-0">
			<span class="text-xs lg:text-sm font-medium text-slate-900 truncate">{ p.Name }</span>
			<div class="flex gap-1 lg:gap-1.5 text-[10px] lg:text-xs shrink-0">
				@if p.Stem != "" {
					<span class="font-medium text-slate-700">{ p.Stem }</span>
				}
				@if p.Branch != "" {
					<span class="font-medium text-slate-600">{ p.Branch }</span>
				}
			</div>
		</div>
		<!-- Stars -->
		<div class="flex-1 px-1.5 py-1 lg:px-2 lg:py-1 space-y-0.5 overflow-hidden">
			for _, star := range p.Stars {
				@if star.Type == 1 {
					<div class="font-semibold text-xs lg:text-sm leading-tight { starColorClass(star.Color) }">{ star.Name }</div>
				} else {
					<div class="text-xs lg:text-sm leading-tight opacity-80 { starColorClass(star.Color) }">{ star.Name }</div>
				}
			}
		</div>
		<!-- Footer -->
		<div class="px-1.5 py-1 lg:px-2 lg:py-1 border-t border-slate-200 text-[10px] lg:text-xs space-y-0.5 shrink-0">
			@if p.LongLife != "" {
				<div class="text-slate-500">Đại hạn: { p.LongLife }</div>
			}
			@if p.MajorCycle != "" {
				<div class="text-slate-400">Tiểu hạn: { p.MajorCycle }</div>
			}
			@if p.MinorCycle != "" {
				<div class="text-slate-400">Tư mệnh: { p.MinorCycle }</div>
			}
		</div>
	</div>
}
