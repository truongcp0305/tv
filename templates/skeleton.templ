package templates

templ skeletonPalace() {
	<div class="bg-white min-h-[120px] lg:min-h-[140px] xl:min-h-[160px] flex flex-col animate-pulse">
		<div class="px-2 py-1 border-b border-slate-200 flex items-center justify-between">
			<div class="h-3 bg-slate-200 rounded w-16"></div>
			<div class="flex gap-1"><div class="h-2.5 bg-slate-200 rounded w-6"></div><div class="h-2.5 bg-slate-200 rounded w-8"></div></div>
		</div>
		<div class="flex-1 px-2 py-1 space-y-1">
			<div class="h-2.5 bg-slate-200 rounded w-full"></div>
			<div class="h-2.5 bg-slate-200 rounded w-3/4"></div>
			<div class="h-2.5 bg-slate-200 rounded w-1/2"></div>
		</div>
		<div class="px-2 py-1 border-t border-slate-200"><div class="h-2 bg-slate-200 rounded w-12"></div></div>
	</div>
}

templ skeletonCenter() {
	<div class="col-span-2 row-span-2 flex items-center justify-center p-4 animate-pulse">
		<div class="space-y-3 max-w-[180px] text-center">
			<div class="h-8 w-8 mx-auto bg-slate-200 rounded-full"></div>
			<div class="space-y-2">
				<div class="h-2.5 bg-slate-200 rounded w-20 mx-auto"></div>
				<div class="h-2.5 bg-slate-200 rounded w-16 mx-auto"></div>
				<div class="h-2.5 bg-slate-200 rounded w-24 mx-auto"></div>
				<div class="h-2.5 bg-slate-200 rounded w-20 mx-auto"></div>
				<div class="h-2.5 bg-slate-200 rounded w-16 mx-auto"></div>
				<div class="h-2.5 bg-slate-200 rounded w-24 mx-auto"></div>
				<div class="h-2.5 bg-slate-200 rounded w-12 mx-auto"></div>
			</div>
		</div>
	</div>
}

templ HoroscopeSkeleton() {
	<div class="w-full overflow-x-auto">
		<div class="chart-grid grid grid-cols-4 gap-[1px] bg-slate-300 border border-slate-300 rounded-lg overflow-hidden w-fit min-w-[400px]">
			{ skeletonPalace() }{ skeletonPalace() }{ skeletonPalace() }{ skeletonPalace() }
			{ skeletonPalace() }{ skeletonCenter() }{ skeletonPalace() }
			{ skeletonPalace() }{ skeletonPalace() }
			{ skeletonPalace() }{ skeletonPalace() }{ skeletonPalace() }{ skeletonPalace() }
		</div>
	</div>
}
