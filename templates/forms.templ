package templates

// ─── Lunar calendar month names (Vietnamese) ──────────────────

var lunarMonths = []string{
	"Giêng", "Hai", "Ba", "Bốn", "Năm", "Sáu",
	"Bảy", "Tám", "Chín", "Mười", "Mười Một", "Mười Hai",
}

// ─── Gender options ───────────────────────────────────────────

type genderOption struct {
	Value string
	Label string
}

var genderOptions = []genderOption{
	{"1", "Nam"},
	{"-1", "Nữ"},
}

// ─── Gender button class helper ───────────────────────────────

// genderBtnClass returns the Tailwind classes for a gender toggle button.
func genderBtnClass(val, selected string) string {
	if val == selected {
		return "bg-indigo-600 text-white border-indigo-600 shadow-sm"
	}
	return "bg-white text-slate-600 border-[#e2e8f0] hover:border-slate-300"
}

templ FormPanel(selectedGender string) {
	<section class="w-full lg:w-[40%] xl:w-[35%] min-w-0 shrink-0 flex flex-col">
		<!-- Header -->
		<div class="px-6 lg:px-8 pt-8 pb-6">
			<h1 class="text-2xl font-semibold tracking-tight text-slate-900">Lập lá số Tử Vi</h1>
			<p class="mt-1.5 text-sm text-slate-500">Nhập thông tin ngày giờ sinh để lập lá số.</p>
		</div>

		<!-- Form -->
		<form id="horoscope-form" class="px-6 lg:px-8 pb-8 space-y-5 flex-1">
			<!-- Full Name -->
			<div>
				<label for="fullName" class="block text-sm font-medium text-slate-700 mb-1.5">Họ và tên</label>
				<input type="text" id="fullName" name="full_name" placeholder="Nguyễn Văn A" class="tv-input w-full" />
			</div>

			<!-- Gender -->
			<div>
				<label class="block text-sm font-medium text-slate-700 mb-1.5">Giới tính</label>
				<div class="flex gap-3">
					for _, g := range genderOptions {
						<button
							type="button"
							name="gender"
							value={ g.Value }
							class="gen-btn rounded-lg border text-sm font-medium py-2.5 px-4 text-center transition-all duration-150 focus:outline-none cursor-pointer select-none { genderBtnClass(g.Value, selectedGender) }"
						>{ g.Label }</button>
					}
				</div>
			</div>

			<!-- Birth Date with Lunar/Solar toggle -->
			<div>
				<div class="flex items-center justify-between mb-1.5">
					<label class="block text-sm font-medium text-slate-700">Ngày sinh</label>
					<button
						type="button"
						id="calendar-toggle"
						class="text-xs font-medium text-indigo-600 hover:text-indigo-700 transition-colors cursor-pointer select-none"
					>Âm lịch</button>
					<input type="hidden" id="calendarMode" name="calendar_mode" value="lunar" />
				</div>
				<div class="tv-num-row">
					<select id="day" name="day" class="tv-select">
						<option value="" disabled>-- Ngày --</option>
						for i := 1; i <= 31; i++ {
							<option value={ i }>{ fmt.Sprintf("%d", i) }</option>
						}
					</select>
					<select id="month" name="month" class="tv-select">
						<option value="" disabled>-- Tháng --</option>
						for i, name := range lunarMonths {
							<option value={ i + 1 }>{ name }</option>
						}
					</select>
					<input type="number" id="year" name="year" placeholder="Năm" min="1900" max="2100" value="2000" class="tv-input [appearance:textfield]" />
				</div>
			</div>

			<!-- Birth Time -->
			<div>
				<label for="hour" class="block text-sm font-medium text-slate-700 mb-1.5">Giờ sinh</label>
				<div class="tv-num-row">
					<select id="hour" name="hour" class="tv-select">
						<option value="" disabled>-- Giờ --</option>
						for i := 0; i < 24; i++ {
							<option value={ i }>{ fmt.Sprintf("%02d:00", i) }</option>
						}
					</select>
					<select id="timePeriod" name="time_period" class="tv-select">
						<option value="">Nhóm giờ</option>
						<option value="ti">Tý (23–1)</option>
						<option value="su">Sửu (1–3)</option>
						<option value="dan">Dần (3–5)</option>
						<option value="mao">Mão (5–7)</option>
						<option value="thin">Thìn (7–9)</option>
						<option value="ti2">Tỵ (9–11)</option>
						<option value="ngo">Ngọ (11–13)</option>
						<option value="mui">Mùi (13–15)</option>
						<option value="than">Thân (15–17)</option>
						<option value="dau">Dậu (17–19)</option>
						<option value="tuat">Tuất (19–21)</option>
						<option value="hoi">Hợi (21–23)</option>
					</select>
				</div>
			</div>

			<!-- Province / City -->
			<div>
				<label for="province" class="block text-sm font-medium text-slate-700 mb-1.5">Tỉnh / Thành phố</label>
				<select id="province" name="province" class="tv-select">
					<option value="" disabled>-- Chọn địa điểm --</option>
					<option value="hanoi">Hà Nội</option>
					<option value="hcm">TP. Hồ Chí Minh</option>
					<option value="danang">Đà Nẵng</option>
					<option value="haiphong">Hải Phòng</option>
					<option value="cantho">Cần Thơ</option>
					<option value="dadongnai">Đồng Nai</option>
					<option value="binhduong">Bình Dương</option>
					<option value="other">Khác...</option>
				</select>
			</div>

			<!-- Submit Button -->
			<div class="pt-3">
				<button
					type="submit"
					id="btn-calculate"
					class="tv-btn-primary"
				>
					<span class="btn-label">Xem tử vi</span>
					<span class="btn-loading" style="display:none;align-items:center;gap:4px;">
						<span style="width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.7);animation:bounce 1.2s infinite ease-in-out;"></span>
						<span style="width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.7);animation:bounce 1.2s infinite ease-in-out .15s;"></span>
						<span style="width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.7);animation:bounce 1.2s infinite ease-in-out .3s;"></span>
					</span>
				</button>
			</div>
		</form>
	</section>
}
