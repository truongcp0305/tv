package templates

import "tuvi/models"

type HoroscopeData struct {
	Palaces []models.Place
	Center  CenterInfo
	Loading bool
}

func getPlace(places []models.Place, idx int) string {
	if idx >= 0 && idx < len(places) {
		return places[idx].PlaceName
	}
	return ""
}

func normalizePlacesForGrid(places []models.Place) []models.Place {
	// Some payloads include a placeholder at index 0 (13 entries total).
	if len(places) == 13 {
		return places[1:13]
	}
	if len(places) > 12 {
		return places[len(places)-12:]
	}
	return places
}

templ HoroscopeGrid(data HoroscopeData) {
	<div id="horoscope"
	     hx-post="/api/stars"
	     hx-trigger="submit from:#horoscope-form"
	     hx-target="#horoscope"
	     hx-swap="innerHTML"
	     class="w-full overflow-x-auto">
		{ if data.Loading {
			HoroscopeSkeleton()
		} else {
			gridContent(data.Palaces, data.Center)
		} }
	</div>
}

templ gridContent(places []models.Place, center CenterInfo) {
	adjustedPlaces := normalizePlacesForGrid(places)
	
	<div class="chart-grid grid grid-cols-4 gap-[1px] bg-slate-300 border border-slate-300 rounded-lg overflow-hidden w-fit min-w-[760px] lg:min-w-0">
		<!-- Row 1: P1 P2 P3 P4 -->
		<div style="grid-row:1;grid-column:1;">{ Palace(Palace{Name: getPlace(adjustedPlaces, 0)}) }</div>
		<div style="grid-row:1;grid-column:2;">{ Palace(Palace{Name: getPlace(adjustedPlaces, 1)}) }</div>
		<div style="grid-row:1;grid-column:3;">{ Palace(Palace{Name: getPlace(adjustedPlaces, 2)}) }</div>
		<div style="grid-row:1;grid-column:4;">{ Palace(Palace{Name: getPlace(adjustedPlaces, 3)}) }</div>

		<!-- Row 2: P12 CENTER P5 -->
		<div style="grid-row:2;grid-column:1;">{ Palace(Palace{Name: getPlace(adjustedPlaces, 11)}) }</div>
		<div style="grid-row:2/span 2;grid-column:2/span 2;">{ Center(center) }</div>
		<div style="grid-row:2;grid-column:4;">{ Palace(Palace{Name: getPlace(adjustedPlaces, 4)}) }</div>

		<!-- Row 3: P11 CENTER P6 -->
		<div style="grid-row:3;grid-column:1;">{ Palace(Palace{Name: getPlace(adjustedPlaces, 10)}) }</div>
		<div style="grid-row:3;grid-column:4;">{ Palace(Palace{Name: getPlace(adjustedPlaces, 5)}) }</div>

		<!-- Row 4: P10 P9 P8 P7 -->
		<div style="grid-row:4;grid-column:1;">{ Palace(Palace{Name: getPlace(adjustedPlaces, 9)}) }</div>
		<div style="grid-row:4;grid-column:2;">{ Palace(Palace{Name: getPlace(adjustedPlaces, 8)}) }</div>
		<div style="grid-row:4;grid-column:3;">{ Palace(Palace{Name: getPlace(adjustedPlaces, 7)}) }</div>
		<div style="grid-row:4;grid-column:4;">{ Palace(Palace{Name: getPlace(adjustedPlaces, 6)}) }</div>
	</div>
}
